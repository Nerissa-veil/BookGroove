# Copy this file to ".env" and fill in your keys.
# Never commit ".env" — it is gitignored.

# SiliconFlow API key (DeepSeek-V3 text analysis)
# https://cloud.siliconflow.cn
OPENAI_API_KEY=sk-your-siliconflow-key-here

# Replicate token (cloud music generation)
# https://replicate.com/account/api-tokens
# Not required if USE_LOCAL_MODEL=true
REPLICATE_API_TOKEN=r8_your-replicate-token-here

# Local MusicGen Medium (~3 GB download on first run)
# true  = local GPU/CPU
# false = Replicate
USE_LOCAL_MODEL=false

# MusicGen (Replicate): large | melody-large | stereo-large | stereo-melody-large
MUSICGEN_MODEL_VERSION=melody-large
MUSICGEN_NORMALIZATION=peak
MUSICGEN_BG_ATTENUATION_DB=2

# Optional UI language: en | cn
# APP_LANG=en
